# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env asla repoya girmez.

# DeepSeek API anahtarı (platform.deepseek.com)
DEEPSEEK_API_KEY=

# Ollama adresi (varsayılan: yerel)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Kurulu Claude Code CLI'ın yolu. Boş bırakılırsa SDK'nın kendi paketindeki sürüm kullanılır.
# Windows + npm kurulumu örneği:
# CLAUDE_CODE_PATH=C:\Users\<kullanıcı>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
CLAUDE_CODE_PATH=

# Claude'un çalışacağı varsayılan proje klasörü
CLAUDE_CWD=

# İşçi çağrısı başına en fazla çıktı token'ı (para güvenliği)
WORKER_MAX_TOKENS=4000

# Arka uç portu
PORT=7777
