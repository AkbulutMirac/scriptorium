# Optional. Copy this file to .env to change settings. .env never goes into the repo.
# The Setup window in the app writes DEEPSEEK_API_KEY for you.

# DeepSeek API key (platform.deepseek.com)
DEEPSEEK_API_KEY=

# Ollama address (default: local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Path to your own Claude Code install. Empty means Scriptorium's own copy (from the Agent SDK).
# Windows + npm install example:
# CLAUDE_CODE_PATH=C:\Users\<user>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
CLAUDE_CODE_PATH=

# Claude's default working folder. Empty means this repo.
CLAUDE_CWD=

# Where your project folders live (listed in the folder picker and history). Empty means the parent of this repo.
PROJECTS_DIR=
# Folders to hide from the lists entirely (names under PROJECTS_DIR or full paths, comma-separated). Folders are never touched.
PROJECTS_EXCLUDE=

# Optional cap on output tokens per worker call. Empty: the provider's default (DeepSeek: 64K with thinking, 8K without).
# Thinking tokens count too, so a small cap can leave no room for the answer.
WORKER_MAX_TOKENS=

# Backend port
PORT=7777
